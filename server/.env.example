# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database (MongoDB Atlas connection string; never commit the real one) ----
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/imovies?retryWrites=true&w=majority

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_DAYS=7

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API (no trailing slash)
CLIENT_URL=http://localhost:5173

# ---- Cookies ----
# Local development (frontend and API both on localhost): lax + false
# Production with frontend and API on different domains: none + true (HTTPS required)
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ---- Booking rules ----
HOLD_MINUTES=7
MAX_SEATS_PER_BOOKING=8

# ---- Initial admin (used only by `npm run create-admin`, Phase 2E) ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
